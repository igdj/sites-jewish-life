{
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.4.1"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/burki/LiipUrlAutoConverterBundle.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/burki/scssphp-bundle"
        },
        {
            "type": "vcs",
            "url": "https://github.com/burki/JMSTranslationBundle"
        }
    ],
    "require": {
        "php": ">=8.4.1",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",

        "symfony/config": "^8.1",
        "symfony/finder": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/yaml": "^8.1",
        "symfony/expression-language": "^8.1",
        "symfony/console": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/dependency-injection": "^8.1",

        "symfony/http-foundation": "^8.1",
        "symfony/event-dispatcher": "^8.1",
        "symfony/cache": "^8.1",
        "symfony/routing": "^8.1",

        "symfony/security-core": "^8.1",
        "jms/translation-bundle": "dev-symfony-8",

        "symfony/twig-bundle": "^8.1",
        "twig/string-extra": "^3.24",
        "twig/intl-extra": "^3.24",
        "twig/extra-bundle": "^3.24",

        "symfony/validator": "^8.1",
        "symfony/property-access": "^8.1",

        "symfony/monolog-bridge": "^8.1",
        "symfony/monolog-bundle": "^4.0",

        "knplabs/knp-menu-bundle": "^3.7",
        "symfony/asset": "^8.1",
        "armin/scssphp-bundle": "dev-master",

        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/orm": "^3.0",
        "stof/doctrine-extensions-bundle": "^1.15",
        "scienta/doctrine-json-functions": "^6.5",

        "cocur/slugify": "^4.7",
        "liip/url-auto-converter-bundle": "dev-symfony-8",

        "symfony/dom-crawler": "^8.1",
        "symfony/css-selector": "^8.1",

        "symfony/web-profiler-bundle": "^8.1",
        "symfony/debug-bundle": "^8.1",

        "symfony/http-client": "^8.1",

        "openspout/openspout": "^4.32"
    },
    "require-dev": {
        "doctrine/annotations": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    }
}
